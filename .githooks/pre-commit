#!/usr/bin/env bash
# Installed by npm run hooks:install. Git executes this on local commits.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if [[ ! -f node_modules/prettier/bin/prettier.cjs ]]; then
  echo "Install dependencies with npm ci before committing." >&2
  exit 1
fi

# Reject partially staged files instead of silently adding unstaged changes.
files=()
while IFS= read -r -d '' file; do
  [[ -f "$file" && ! -L "$file" ]] || continue
  if ! git diff --quiet -- "$file"; then
    echo "Stage or stash unstaged changes in $file before formatting." >&2
    exit 1
  fi
  files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

for file in "${files[@]}"; do
  node node_modules/prettier/bin/prettier.cjs --write --ignore-unknown -- "$file"
  git add -- "$file"
done

# Enforce the same full-repository lint policy as GitHub Actions.
npm run lint
